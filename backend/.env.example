# Copiez ce fichier en ".env" puis remplissez VOS valeurs (ne jamais committer .env)
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymmanager_db
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres

# Secret pour signer les tokens JWT : mettez une longue chaine aleatoire
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h
